ChatBox.ChatBox {
    LinesStartFromTop = false;
    NewLinesBelowOthers = true;
    Position = (10, (&.h - h) - 10);
    ScrollbarPolicy = Automatic;
    Size = (&.w - 20, 150);
    TextColor = black;
    TextSize = 13;

    Renderer {
        BackgroundColor = #F5F5F5;
        BorderColor = black;
        Borders = (1, 1, 1, 1);
        Padding = (0, 0, 0, 0);
        TextureBackground = None;

        Scrollbar {
            ArrowBackgroundColor = #F5F5F5;
            ArrowBackgroundColorHover = white;
            ArrowColor = #3C3C3C;
            ArrowColorHover = black;
            TextureArrowDown = None;
            TextureArrowDownHover = None;
            TextureArrowUp = None;
            TextureArrowUpHover = None;
            TextureThumb = None;
            TextureThumbHover = None;
            TextureTrack = None;
            TextureTrackHover = None;
            ThumbColor = #DCDCDC;
            ThumbColorHover = #E6E6E6;
            TrackColor = #F5F5F5;
        }
    }
}

ScrollablePanel.Players {
    ContentSize = (0, 0);
    HorizontalScrollbarPolicy = Automatic;
    Position = (10, 10);
    Size = ((Map.x - 10) - x, (Settings.y - 10) - y);

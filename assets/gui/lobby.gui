                TextureTrackHover = None;
                ThumbColor = #DCDCDC;
                ThumbColorHover = #E6E6E6;
                TrackColor = #F5F5F5;
            }
        }
    }

    BitmapButton.MapZoom {
        Image = "Magnifying_glass_icon.png" Smooth;
        ImageScaling = 0;
        Position = (158, max(150, (&.h - h) - 10));
        Size = (32, 32);
        TextSize = 13;

        Renderer {
            BackgroundColor = #F5F5F5;
            BackgroundColorDisabled = #E6E6E6;
            BackgroundColorDown = #EBEBEB;
            BackgroundColorHover = white;
            BorderColor = #3C3C3C;
            BorderColorDisabled = #7D7D7D;
            BorderColorDown = black;
            BorderColorFocused = #1E1EB4;
            BorderColorHover = black;
            Borders = (1, 1, 1, 1);
            TextColor = #3C3C3C;
            TextColorDisabled = #7D7D7D;
            TextColorDown = black;
            TextColorHover = black;
            Texture = None;
            TextureDisabled = None;
            TextureDown = None;
            TextureDownFocused = None;
            TextureDownHover = None;
            TextureFocused = None;
            TextureHover = None;
        }
    }

    BitmapButton.MapChange {
        Image = "switch-horizontal-01-svgrepo-com.png" Smooth;
        ImageScaling = 0;
        Position = (116, MapZoom.y);
        Size = (32, 32);
        TextSize = 13;


ScrollablePanel.MapData {
    ContentSize = (0, 0);
    HorizontalScrollbarPolicy = Automatic;
    Position = ((&.w - w) - 10, (Map.y + Map.h) + 10);
    Size = (Map.w, (ChatBox.y - 10) - y);
    VerticalScrollbarPolicy = Automatic;

    Renderer {
        BackgroundColor = white;
        BorderColor = black;
        Borders = (1, 1, 1, 1);
        TextureBackground = None;

        Scrollbar {
            ArrowBackgroundColor = #F5F5F5;
            ArrowBackgroundColorHover = white;
            ArrowColor = #3C3C3C;
            ArrowColorHover = black;
            TextureArrowDown = None;
            TextureArrowDownHover = None;
            TextureArrowUp = None;
            TextureArrowUpHover = None;
            TextureThumb = None;
            TextureThumbHover = None;
            TextureTrack = None;
            TextureTrackHover = None;
            ThumbColor = #DCDCDC;
            ThumbColorHover = #E6E6E6;
            TrackColor = #F5F5F5;
        }
    }

    Label.MapSize {
        HorizontalAlignment = Center;
        Position = (0, 30);
        Renderer = &1;
        ScrollbarPolicy = Automatic;
        Size = (100%, 18);
        Text = "128x128 (4096x4096)";
        TextSize = 13;
    }

    SeparatorLine.SeparatorLine1 {
        Position = (0, 25);
        Size = (100%, 1);

        Renderer {
            Color = black;
        }
    }

    Label.MapName {
        HorizontalAlignment = Center;
        Position = (0, 5);
        Renderer = &1;
        ScrollbarPolicy = Automatic;
        Size = (100%, 18);
        Text = Label;
        TextSize = 13;
    }

    BitmapButton.MapZoom {
        Image = "Magnifying_glass_icon.png" Smooth;
        ImageScaling = 0;
        Position = ((100% - w) - 10, max(150, (&.h - h) - 10));
        Renderer = &2;
        Size = (32, 32);
        TextSize = 13;
    }

    BitmapButton.MapChange {
        Image = "switch-horizontal-01-svgrepo-com.png" Smooth;
        ImageScaling = 0;
        Position = ((MapZoom.x - w) - 10, MapZoom.y);
        Renderer = &2;
        Size = (32, 32);
        TextSize = 13;
    }

    Label.MapObjects {
        HorizontalAlignment = Center;
        Position = (0, 90);
        Renderer = &1;
        ScrollbarPolicy = Automatic;
        Size = (100%, 18);
        Text = "10 hazard, 10 resources";
        TextSize = 13;
    }

    Label.MapOrigin {
        HorizontalAlignment = Center;
        Position = (0, 50);
        Renderer = &1;
        ScrollbarPolicy = Automatic;
        Size = (100%, 18);
        Text = "From Dune 2000";
        TextSize = 13;
    }

    Label.MapAuthor {
        HorizontalAlignment = Center;
        Position = (0, 70);
        Renderer = &1;
        ScrollbarPolicy = Automatic;
        Size = (100%, 18);
        Text = "Made by Westwood";
        TextSize = 13;
    }
}

Panel.Map {
    Position = ((&.w - w) - 10, 10);
    Size = (300, 300);
    TextSize = 10;

    Renderer {
        BackgroundColor = white;
        BorderColor = black;
        TextureBackground = None;
    }

    Picture.MapPic {
        Position = ((100% - w) / 2, (100% - h) / 2);
        Size = (100%, 100%);
        TextSize = 10;

        Renderer {
            Texture = "Magnifying_glass_icon.png" Smooth;
            TransparentTexture = false;
        }
    }
}

Button.Leave {
    Position = ((Start.x + Start.w) + 10, (&.h - h) - 10);
    Renderer = &3;
    Size = (120, 20);
    Text = "Leave lobby";
    TextSize = 13;
}

Button.Start {
    Position = (10, (&.h - h) - 10);
    Renderer = &3;
    Size = (120, 20);
    Text = "Start game";
    TextSize = 13;
}
